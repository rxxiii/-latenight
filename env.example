# Copy this file to .env and fill in your values.

# Get this from https://discord.com/developers/applications -> your app -> Bot -> Token
DISCORD_TOKEN=your-bot-token-here

# Default command prefix (servers can override with ,prefix set)
DEFAULT_PREFIX=,

# Optional: paste a server (guild) ID here while developing so slash commands
# sync instantly to that one server instead of globally (global sync can take
# up to an hour to show up).
DEV_GUILD_ID=

# Optional: only needed on Railway once you add a Volume. Leave blank locally.
DB_PATH=
